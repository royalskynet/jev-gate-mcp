# Jev Decision Gateway environment (copy to .env / export; NEVER commit real keys).
# One shared OpenRouter credential drives ALL live Jev/System One traffic
# (typesafe/jev-1.13 over OpenRouter POST /api/v1/systemone); there is no second
# TypeSafe key. The native TypeSafe adapter remains for the offline contract
# fixture and optional config only.
# See gateway/operations/runbook.md for tuning and live-command details.
JEV_PROVIDER=openrouter          # openrouter | fake (typesafe is offline-fixture only)
JEV_MODEL=typesafe/jev-1.13
JEV_API_KEY_FILE=$HOME/.creds/kv/OPENROUTER_API_KEY.txt
JEV_POLICY_DIR=                  # optional override registry dir

# telemetry (JSONL to stderr)
JEV_TELEMETRY=on                 # off to silence
JEV_TELEMETRY_LEVEL=info

# circuit breaker (opossum)
JEV_BREAKER_ERROR_THRESHOLD=60
JEV_BREAKER_VOLUME=5
JEV_BREAKER_RESET_MS=30000

# operational switches
JEV_KILL_SWITCH=0                # 1 = immediate global shutdown
JEV_RUN_SMOKE=0                  # 1 = opt-in live Jev smoke (single OpenRouter key)
JEV_RUN_EVAL=0                   # 1 = opt-in live GPT/Claude tool-selection eval
JEV_EVAL_MODELS=openai/gpt-5.4-mini,anthropic/claude-haiku-4.5

# Streamable HTTP（預設只聽 loopback；非 loopback 必須設 token file + hosts）
JEV_HTTP_HOST=127.0.0.1
JEV_HTTP_PORT=3456
JEV_HTTP_AUTH_TOKEN_FILE=        # 每行單一高熵 bearer token；不要把 token 放 env
JEV_HTTP_ALLOWED_HOSTS=          # 逗號分隔 hostname；公開部署必填
JEV_HTTP_ALLOWED_ORIGINS=        # 逗號分隔 hostname；無 Origin 的非瀏覽器 client 可通過
JEV_HTTP_RATE_LIMIT=60
JEV_HTTP_RATE_WINDOW_SECONDS=60
JEV_HTTP_MAX_IN_FLIGHT=16
JEV_MAX_BODY_BYTES=262144
JEV_HTTP_SHUTDOWN_MS=10000
