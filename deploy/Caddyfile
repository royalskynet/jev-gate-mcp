{$JEV_PUBLIC_HOST} {
  encode zstd gzip
  reverse_proxy jev-gateway:3456 {
    health_uri /health
    health_interval 15s
    health_timeout 3s
  }
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    -Server
  }
}
