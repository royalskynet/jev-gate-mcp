# 公開 DNS 名稱；Caddy 會自動申請/更新 TLS 憑證。
JEV_PUBLIC_HOST=jev.example.com

# 兩個檔案都只放單一 secret，不要提交內容。
OPENROUTER_API_KEY_FILE=/absolute/path/to/OPENROUTER_API_KEY.txt
JEV_HTTP_AUTH_TOKEN_FILE=/absolute/path/to/jev-http-bearer-token.txt

JEV_HTTP_RATE_LIMIT=60
JEV_HTTP_RATE_WINDOW_SECONDS=60
JEV_HTTP_MAX_IN_FLIGHT=16
JEV_TELEMETRY=on
JEV_TELEMETRY_LEVEL=info
